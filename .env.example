# Copy this file to .env and adjust the values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra trusted origins for forms, e.g. https://atraquen-el-barco.onrender.com
# (on Render the service's own address is added automatically).
CSRF_TRUSTED_ORIGINS=
# Defaults to SQLite (db.sqlite3) when unset. Production example (Neon):
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
